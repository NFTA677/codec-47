# Copia este archivo como .env y rellena los valores. NUNCA subas .env a GitHub.
PORT=3000

# MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=codec47

# Cadena larga y aleatoria (en Render usa "Generate value")
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# NVIDIA (build.nvidia.com -> API Keys)
NVIDIA_API_KEY=nvapi-xxxxxxxx
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Respaldo si el principal falla o tarda
AI_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Zona horaria por defecto (la web la actualiza con la de tu navegador)
DEFAULT_TZ=America/Mexico_City

# Registro: si no pones true, solo se puede registrar la PRIMERA cuenta (la tuya).
ALLOW_REGISTER=false

# true = la IA "piensa" antes de responder (más lenta)
AI_THINKING=false
